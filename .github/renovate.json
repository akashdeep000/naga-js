{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:base", "group:allNonMajor", ":preserveSemverRanges", ":disablePeerDependencies"],
  "labels": ["dependencies"],
  "packageRules": [
    {
      "matchPackageNames": ["@napi/cli", "napi", "napi-build", "napi-derive"],
      "addLabels": ["napi-rs"],
      "groupName": "napi-rs"
    },
    {
      "description": "naga patch and minor bumps automerge once CI (including golden snapshot tests) is green; sync-version.yml aligns the package version",
      "matchManagers": ["cargo"],
      "matchPackageNames": ["naga"],
      "matchUpdateTypes": ["patch", "minor"],
      "addLabels": ["naga-upstream"],
      "groupName": "naga",
      "automerge": true
    },
    {
      "description": "naga major bumps need human acceptance: merge the PR manually, automation tags and publishes after",
      "matchManagers": ["cargo"],
      "matchPackageNames": ["naga"],
      "matchUpdateTypes": ["major"],
      "addLabels": ["naga-upstream", "needs-review"],
      "groupName": "naga",
      "automerge": false
    },
    {
      "matchPackagePatterns": ["^eslint", "^@typescript-eslint"],
      "groupName": "linter"
    }
  ],
  "commitMessagePrefix": "chore: ",
  "commitMessageAction": "bump up",
  "commitMessageTopic": "{{depName}} version",
  "ignoreDeps": []
}
