{
  "name": "naga-js",
  "version": "30.0.1",
  "naga": "30.0.1",
  "description": "JavaScript bindings for Naga — WGSL/SPIR-V/GLSL shader validation and translation",
  "main": "index.js",
  "types": "index.d.ts",
  "browser": "browser.js",
  "repository": {
    "url": "git+https://github.com/akashdeep000/naga-js.git",
    "type": "git"
  },
  "license": "MIT",
  "keywords": [
    "naga",
    "wgsl",
    "glsl",
    "hlsl",
    "msl",
    "spir-v",
    "shader",
    "shader-translation",
    "webgpu",
    "napi-rs",
    "N-API",
    "Rust",
    "node-addon"
  ],
  "files": [
    "index.d.ts",
    "index.js",
    "browser.js"
  ],
  "napi": {
    "binaryName": "naga-js",
    "targets": [
      "x86_64-apple-darwin",
      "aarch64-apple-darwin",
      "x86_64-pc-windows-msvc",
      "i686-pc-windows-msvc",
      "aarch64-pc-windows-msvc",
      "x86_64-unknown-linux-gnu",
      "aarch64-unknown-linux-gnu",
      "armv7-unknown-linux-gnueabihf",
      "x86_64-unknown-linux-musl",
      "aarch64-unknown-linux-musl",
      "aarch64-linux-android",
      "armv7-linux-androideabi",
      "x86_64-linux-android",
      "x86_64-unknown-freebsd",
      "wasm32-wasip1-threads"
    ],
    "wasm": {
      "browser": {
        "fs": false,
        "asyncInit": false,
        "buffer": false,
        "errorEvent": true
      }
    }
  },
  "engines": {
    "node": ">= 10.16.0 < 11 || >= 11.8.0 < 12 || >= 12.0.0"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "scripts": {
    "artifacts": "napi artifacts",
    "bench": "node --import @oxc-node/core/register benchmark/bench.ts",
    "build": "napi build --platform --release",
    "build:debug": "napi build --platform",
    "format": "run-p format:oxfmt format:rs",
    "format:oxfmt": "oxfmt",
    "format:rs": "cargo fmt",
    "lint": "oxlint",
    "postinstall": "lefthook install",
    "prepublishOnly": "napi prepublish -t npm",
    "test": "ava",
    "version": "napi version",
    "version:sync": "node scripts/sync-version.mjs"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "lefthook"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "^20.4.0",
    "@commitlint/config-conventional": "^20.4.0",
    "@emnapi/core": "^2.0.0-alpha.4",
    "@emnapi/runtime": "^2.0.0-alpha.4",
    "@napi-rs/cli": "^3.8.6",
    "@napi-rs/wasm-runtime": "^1.2.3",
    "@oxc-node/core": "^0.1.0",
    "@types/node": "^22.20.2",
    "ava": "^8.0.1",
    "chalk": "^6.0.0",
    "emnapi": "^2.0.0-alpha.4",
    "lefthook": "^2.1.14",
    "npm-run-all2": "^9.0.3",
    "oxfmt": "^0.67.0",
    "oxlint": "^1.79.0",
    "prettier": "^3.9.6",
    "tinybench": "^6.1.3",
    "typescript": "^7.0.2"
  },
  "ava": {
    "extensions": [
      "ts"
    ],
    "timeout": "2m",
    "workerThreads": false,
    "environmentVariables": {
      "TS_NODE_PROJECT": "./tsconfig.json"
    },
    "nodeArguments": [
      "--import",
      "@oxc-node/core/register"
    ]
  },
  "packageManager": "pnpm@12.4.1"
}
